# The Snap environment-variable reference. Never commit real secrets.
# Required values are marked REQUIRED; all others are optional or feature-specific.

# --- Public site identity ---
NEXT_PUBLIC_SITE_URL=https://thegamesnap.com
SITE_URL=https://thegamesnap.com

# --- Sanity public reads (REQUIRED) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-05-03

# Sanity server writes / Studio (REQUIRED for publishing and Sanity-backed sync jobs)
SANITY_API_WRITE_TOKEN=
# REQUIRED for signed Sanity webhook POSTs. Configure this exact value as the
# webhook secret in Sanity; it is not an Authorization bearer token.
SANITY_WEBHOOK_SECRET=

# Supported legacy/server aliases; prefer the names above for new configuration.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_TOKEN=
SANITY_WRITE_TOKEN=
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2025-05-03

# --- PostgreSQL / Prisma (REQUIRED) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Clerk authentication (REQUIRED when account features are enabled) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# At least one admin policy is REQUIRED for /admin. Explicit user IDs work on
# their own. Role-based access requires both an allowed Clerk organization ID
# and an allowed organization role; arbitrary session/public metadata is not
# treated as an admin role.
ADMIN_USER_IDS=
ADMIN_ALLOWED_ROLES=
ADMIN_ALLOWED_ORG_IDS=

# --- Newsletter privacy (REQUIRED when newsletter signup is enabled) ---
# Generate a stable random value of at least 32 characters and do not rotate it
# after unsubscribe links have been issued.
NEWSLETTER_SIGNING_SECRET=
NEWSLETTER_CONSENT_VERSION=2026-08-09
# Email delivery is REQUIRED to send double-opt-in confirmations.
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_REPLY_TO=

# --- Automation and operational endpoint authentication ---
# REQUIRED in production. Vercel Cron sends this value as
# Authorization: Bearer <CRON_SECRET> to both configured cron routes.
CRON_SECRET=
# Optional dedicated overrides. Callers still use Authorization: Bearer.
SYNC_CRON_SECRET=
GSC_AUDIT_SECRET=
REVALIDATE_SECRET=
SANITY_STANDINGS_REVALIDATE_SECRET=
# Optional dedicated bearer token for webhook diagnostic GET endpoints.
WEBHOOK_DIAGNOSTIC_SECRET=

# --- NFL data automation ---
SPORTSDATA_API_KEY=
SPORTSDATA_ENABLED=true
NFL_SEASON=2026
NFL_SYNC_MODE=in-season
# Legacy season alias used only by older scripts.
SEASON=2026

# --- Google Search Console audit ---
GSC_PROPERTY_URI=
GSC_SERVICE_ACCOUNT_EMAIL=
# Store multiline keys using the escaped-newline format expected by the host.
GSC_SERVICE_ACCOUNT_PRIVATE_KEY=
GSC_SITEMAP_URL=https://thegamesnap.com/sitemap.xml
GSC_AUDIT_LOOKBACK_DAYS=28
GSC_AUDIT_CONTENT_LIMIT=100

# --- Contact form ---
NEXT_PUBLIC_FORMSPREE_ID=

# --- Consent-gated analytics ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_INTERNAL_ANALYTICS_ENABLED=false
NEXT_PUBLIC_INTERNAL_ANALYTICS_VIEW_SAMPLE_RATE=1
NEXT_PUBLIC_INTERNAL_ANALYTICS_CLICK_SAMPLE_RATE=1
# REQUIRED when first-party internal analytics is enabled. Use a dedicated
# random secret of at least 32 characters to HMAC rate-limit identifiers.
ANALYTICS_HMAC_SECRET=

# --- Consent-gated advertising ---
# Keep false. The built-in controls are not a Google-certified CMP; enable ads
# only after an approved CMP and the applicable legal/business review are ready.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=
NEXT_PUBLIC_ADSENSE_NAVBAR_SLOT_ID=
NEXT_PUBLIC_ADSENSE_FOOTER_SLOT_ID=

# --- Vercel KV / Upstash view counter ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Social publishing ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=
# Supported aliases used by older integrations.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# --- Optional alerts, UI flags, and native app settings ---
AUTH_ALERT_WEBHOOK_URL=
MONITORING_ALERT_WEBHOOK_URL=
CAP_SERVER_URL=
NEXT_PUBLIC_ENABLE_LIGHT_THEME=false
NEXT_PUBLIC_FANTASY_NAV_MODE=
ENABLE_EVENT_SCHEMA=false
