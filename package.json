{
  "name": "the-snap",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.16 <23"
  },
  "overrides": {
    "@vercel/python-analysis": {
      "minimatch": "10.2.6"
    },
    "@vercel/static-config": {
      "ajv": "8.20.0"
    },
    "smol-toml": "1.7.1",
    "tar": "7.5.22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "prisma generate && next build",
    "build:local": "env-cmd -f .env.local next build",
    "deploy": "npm run deploy:prod",
    "deploy:prod": "vercel deploy --prod --yes",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:copy": "npx cap copy ios",
    "db:generate": "env-cmd -f .env.local prisma generate",
    "db:migrate": "env-cmd -f .env.local prisma migrate dev",
    "db:deploy": "env-cmd -f .env.local prisma migrate deploy",
    "db:deploy:ci": "prisma migrate deploy",
    "db:studio": "env-cmd -f .env.local prisma studio",
    "sync:games": "ts-node --transpile-only --compiler-options '{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' scripts/sync-games.ts",
    "backfill:tagRefs": "node scripts/backfill-tag-refs.mjs",
    "backfill:tagRefs:dry": "node scripts/backfill-tag-refs.mjs --dry-run",
    "audit:search-content": "node scripts/audit-search-content.mjs",
    "audit:betting-content": "node scripts/audit-search-content.mjs --betting-details",
    "consolidate:betting-guides": "node scripts/consolidate-betting-guides.mjs",
    "sync:schedule": "node scripts/sync-espn-schedule.mjs",
    "improve:evergreen": "node scripts/improve-evergreen-articles.mjs",
    "improve:hero-rb": "node scripts/improve-hero-rb-guide.mjs",
    "improve:mvp-odds": "node scripts/improve-mvp-odds-guide.mjs",
    "seed:primetime": "node scripts/seed-primetime-tags.mjs",
    "seed:topic-hubs": "node scripts/seed-topic-hubs.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.1.0",
    "@clerk/nextjs": "6.39.6",
    "@formspree/react": "^3.0.0",
    "@portabletext/react": "^3.2.1",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-slot": "^1.2.4",
    "@sanity/client": "7.26.2",
    "@sanity/image-url": "^1.1.0",
    "@sanity/vision": "5.31.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.525.0",
    "next": "16.3.0",
    "next-sanity": "12.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.5.0",
    "react-is": "19.2.8",
    "sanity": "5.31.1",
    "styled-components": "6.5.1",
    "svix": "1.99.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "twitter-api-v2": "^1.27.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "env-cmd": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "picomatch": "4.0.5",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vercel": "58.9.0",
    "vitest": "4.1.10"
  }
}
